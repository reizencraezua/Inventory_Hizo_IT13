@page "/suppliers"
@inject SupplierService SupplierService

<PageTitle>Suppliers - Inventory Management</PageTitle>

<h1>Suppliers</h1>

<div class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <input type="text" class="form-control" placeholder="Search suppliers..." @bind="searchTerm" @bind:event="oninput" />
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-secondary me-2" @onclick="ToggleShowArchived">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-archive me-1" viewBox="0 0 16 16">
                    <path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1V2zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5H2zm13-3H1v2h14V2zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                </svg>
                @(showArchived ? "Hide Archived" : "Show Archived")
            </button>
            <button class="btn btn-primary" @onclick="ShowAddSupplierModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle me-1" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
                </svg>
                Add New Supplier
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Contact Person</th>
                    <th>Phone</th>
                    <th>Email</th>
                    <th>Address</th>
                    <th>Date Added</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!suppliers.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center">No suppliers found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var supplier in suppliers)
                    {
                        <tr>
                            <td>@supplier.SupplierID</td>
                            <td>@supplier.SupplierName</td>
                            <td>@(supplier.ContactPerson ?? "N/A")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(supplier.PhoneNumber))
                                {
                                    <a href="tel:@supplier.PhoneNumber">@supplier.PhoneNumber</a>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(supplier.Email))
                                {
                                    <a href="mailto:@supplier.Email">@supplier.Email</a>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(supplier.Address))
                                {
                                    <span title="@supplier.Address">
                                        @(supplier.Address.Length > 30 ? supplier.Address.Substring(0, 30) + "..." : supplier.Address)
                                    </span>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td>@supplier.DateAdded.ToString("MM/dd/yyyy")</td>
                            <td>
                                @if (supplier.IsArchived)
                                {
                                    <span class="badge bg-secondary">Archived</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <div class="action-buttons">
                                    <button class="btn btn-sm btn-warning" @onclick="() => ShowEditSupplierModal(supplier)" title="Edit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
                                        </svg>
                                    </button>
                                    @if (!supplier.IsArchived)
                                    {
                                        <button class="btn btn-sm btn-delete" @onclick="() => ArchiveSupplier(supplier)" title="Archive">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-archive" viewBox="0 0 16 16">
                                                <path d="M0 2a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1v7.5a2.5 2.5 0 0 1-2.5 2.5h-9A2.5 2.5 0 0 1 1 12.5V5a1 1 0 0 1-1-1V2zm2 3v7.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V5H2zm13-3H1v2h14V2zM5 7.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5z"/>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => RestoreSupplier(supplier)" title="Restore">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-counterclockwise" viewBox="0 0 16 16">
                                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 1-4.546 2.914.5.5 0 0 0-.908-.417A6 6 0 1 0 8 2v1z"/>
                                                <path d="M8 4.466V.534a.25.25 0 0 0-.41-.192L5.23 2.308a.25.25 0 0 0 0 .384l2.36 1.966A.25.25 0 0 0 8 4.466z"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

<!-- Add/Edit Supplier Modal -->
@if (showSupplierModal)
{
    <div class="modal show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingSupplier?.SupplierID > 0 ? "Edit Supplier" : "Add New Supplier")</h5>
                    <button type="button" class="btn-close" @onclick="CloseSupplierModal"></button>
                </div>
                <EditForm Model="@supplierForm" OnValidSubmit="@SaveSupplier">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Supplier Name *</label>
                            <InputText @bind-Value="supplierForm.SupplierName" class="form-control" />
                            <ValidationMessage For="@(() => supplierForm.SupplierName)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Contact Person</label>
                            <InputText @bind-Value="supplierForm.ContactPerson" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <InputText @bind-Value="supplierForm.PhoneNumber" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <InputText @bind-Value="supplierForm.Email" type="email" class="form-control" />
                            <ValidationMessage For="@(() => supplierForm.Email)" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <InputTextArea @bind-Value="supplierForm.Address" class="form-control" rows="3" />
                        </div>
                        @if (!string.IsNullOrEmpty(supplierMessage))
                        {
                            <div class="alert alert-@(supplierSuccess ? "success" : "danger")">@supplierMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseSupplierModal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Supplier> suppliers = new();
    private bool isLoading = true;
    private bool showArchived = false;
    private string _searchTerm = string.Empty;
    
    private string searchTerm
    {
        get => _searchTerm;
        set
        {
            _searchTerm = value;
            HandleSearch();
        }
    }
    
    private bool showSupplierModal = false;
    private Supplier? editingSupplier;
    private SupplierFormModel supplierForm = new();
    private string? supplierMessage;
    private bool supplierSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            suppliers = await SupplierService.GetAllSuppliersAsync(showArchived);
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleShowArchived()
    {
        showArchived = !showArchived;
        searchTerm = string.Empty; // Clear search when toggling
        await LoadData();
    }

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            LoadData();
        }
        else
        {
            SearchSuppliers();
        }
    }

    private async Task SearchSuppliers()
    {
        isLoading = true;
        try
        {
            suppliers = await SupplierService.SearchSuppliersAsync(searchTerm);
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private void ShowAddSupplierModal()
    {
        editingSupplier = null;
        supplierForm = new SupplierFormModel();
        supplierMessage = null;
        showSupplierModal = true;
    }

    private void ShowEditSupplierModal(Supplier supplier)
    {
        editingSupplier = supplier;
        supplierForm = new SupplierFormModel
        {
            SupplierID = supplier.SupplierID,
            SupplierName = supplier.SupplierName,
            ContactPerson = supplier.ContactPerson,
            PhoneNumber = supplier.PhoneNumber,
            Email = supplier.Email,
            Address = supplier.Address
        };
        supplierMessage = null;
        showSupplierModal = true;
    }

    private void CloseSupplierModal()
    {
        showSupplierModal = false;
        supplierForm = new SupplierFormModel();
        supplierMessage = null;
    }

    private async Task SaveSupplier()
    {
        supplierMessage = null;
        try
        {
            var supplier = new Supplier
            {
                SupplierID = supplierForm.SupplierID,
                SupplierName = supplierForm.SupplierName,
                ContactPerson = supplierForm.ContactPerson,
                PhoneNumber = supplierForm.PhoneNumber,
                Email = supplierForm.Email,
                Address = supplierForm.Address
            };

            bool result;
            if (editingSupplier?.SupplierID > 0)
            {
                result = await SupplierService.UpdateSupplierAsync(supplier);
            }
            else
            {
                result = await SupplierService.AddSupplierAsync(supplier);
            }

            if (result)
            {
                supplierSuccess = true;
                supplierMessage = "Supplier saved successfully!";
                await LoadData();
                await Task.Delay(1000);
                CloseSupplierModal();
            }
            else
            {
                supplierSuccess = false;
                supplierMessage = "Failed to save supplier. Please try again.";
            }
        }
        catch
        {
            supplierSuccess = false;
            supplierMessage = "An error occurred. Please try again.";
        }
    }

    private class SupplierFormModel
    {
        public int SupplierID { get; set; }

        [Required(ErrorMessage = "Supplier name is required")]
        public string SupplierName { get; set; } = string.Empty;

        public string? ContactPerson { get; set; }

        public string? PhoneNumber { get; set; }

        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string? Email { get; set; }

        public string? Address { get; set; }
    }

    private async Task ArchiveSupplier(Supplier supplier)
    {
        if (await SupplierService.ArchiveSupplierAsync(supplier.SupplierID))
        {
            await LoadData();
        }
    }

    private async Task RestoreSupplier(Supplier supplier)
    {
        if (await SupplierService.RestoreSupplierAsync(supplier.SupplierID))
        {
            await LoadData();
        }
    }
}

