@page "/transactions"
@inject StockService StockService

<PageTitle>Transactions - Inventory Management</PageTitle>

<h1>Transaction Logs</h1>

<div class="card mb-3">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" placeholder="Product, Supplier, or User..." @bind="SearchTerm" @bind:event="oninput" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Transaction Type</label>
                <select class="form-select" @bind="filterType" @bind:after="ApplyFilters">
                    <option value="">All</option>
                    <option value="ADD">ADD</option>
                    <option value="REMOVE">REMOVE</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Date From</label>
                <input type="date" class="form-control" @bind="dateFrom" @bind:after="ApplyFilters" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Date To</label>
                <input type="date" class="form-control" @bind="dateTo" @bind:after="ApplyFilters" />
            </div>
            <div class="col-md-3">
                <label class="form-label">&nbsp;</label>
                <button class="btn btn-secondary w-100" @onclick="ClearFilters">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-circle me-1" viewBox="0 0 16 16">
                        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                        <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z"/>
                    </svg>
                    Clear Filters
                </button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status"></div>
    </div>
}
else
{
    <div class="mb-2">
        <span class="badge bg-primary">Total Transactions: @filteredTransactions.Count</span>
    </div>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th class="text-center">Transaction ID</th>
                            <th>Date & Time</th>
                            <th>Product</th>
                            <th>Supplier</th>
                            <th>Type</th>
                            <th>User</th>
                        </tr>
                    </thead>
            <tbody>
                @if (!filteredTransactions.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center">No transactions found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var transaction in filteredTransactions)
                    {
                        <tr>
                            <td class="text-center">@transaction.TransactionID</td>
                            <td>@transaction.TransactionDate.ToString("MM/dd/yyyy HH:mm:ss")</td>
                            <td>@(transaction.ProductName ?? "N/A")</td>
                            <td>@(transaction.SupplierName ?? "N/A")</td>
                            <td>
                                @if (transaction.TransactionType == "ADD")
                                {
                                    <span class="badge bg-success">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-up" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8 15a.5.5 0 0 0 .5-.5V2.707l3.146 3.147a.5.5 0 0 0 .708-.708l-4-4a.5.5 0 0 0-.708 0l-4 4a.5.5 0 1 0 .708.708L7.5 2.707V14.5a.5.5 0 0 0 .5.5z"/>
                                        </svg> ADD
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-down" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M8 1a.5.5 0 0 1 .5.5v11.793l3.146-3.147a.5.5 0 0 1 .708.708l-4 4a.5.5 0 0 1-.708 0l-4-4a.5.5 0 0 1 .708-.708L7.5 13.293V1.5A.5.5 0 0 1 8 1z"/>
                                        </svg> REMOVE
                                    </span>
                                }
                            </td>
                            <td>@(transaction.UserName ?? "N/A")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<StockTransaction> transactions = new();
    private List<StockTransaction> filteredTransactions = new();
    private bool isLoading = true;
    private string searchTerm = string.Empty;
    private string filterType = string.Empty;
    private DateTime? dateFrom = null;
    private DateTime? dateTo = null;

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value;
            ApplyFilters();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            transactions = await StockService.GetTransactionHistoryAsync();
            ApplyFilters();
        }
        catch { }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilters()
    {
        IEnumerable<StockTransaction> query = transactions.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var term = searchTerm.ToLower();
            query = query.Where(t =>
                (t.ProductName?.ToLower().Contains(term) ?? false) ||
                (t.SupplierName?.ToLower().Contains(term) ?? false) ||
                (t.UserName?.ToLower().Contains(term) ?? false) ||
                (t.TransactionID.ToString().Contains(term))
            );
        }

        if (!string.IsNullOrEmpty(filterType))
        {
            query = query.Where(t => t.TransactionType == filterType);
        }

        if (dateFrom.HasValue)
        {
            var fromDate = dateFrom.Value.Date;
            query = query.Where(t => t.TransactionDate.Date >= fromDate);
        }

        if (dateTo.HasValue)
        {
            var toDate = dateTo.Value.Date.AddDays(1).AddTicks(-1); // End of the day
            query = query.Where(t => t.TransactionDate <= toDate);
        }

        filteredTransactions = query.ToList();
        StateHasChanged();
    }

    private void ClearFilters()
    {
        searchTerm = string.Empty;
        filterType = string.Empty;
        dateFrom = null;
        dateTo = null;
        ApplyFilters();
    }
}

